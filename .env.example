# Docker Compose local-development template.
# start.sh, start.command, start.cmd, and start.ps1 create .env securely on first run.
# Copy and edit this file manually only when the automatic start files cannot be used.
POSTGRES_DB=codequest
POSTGRES_USER=codequest
POSTGRES_PASSWORD=replace-with-a-local-password
# Generate a unique value with at least 32 bytes. Never reuse a production secret.
JAVA_RUNNER_TOKEN=replace-with-a-long-random-runner-token
# Use a different secret from JAVA_RUNNER_TOKEN.
JAVASCRIPT_RUNNER_TOKEN=replace-with-a-long-random-javascript-runner-token
